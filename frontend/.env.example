# Base URL of the Swiftly backend the app talks to.
# Expo inlines EXPO_PUBLIC_* variables into the app bundle at build time.
#
# Web / Android emulator:   http://localhost:8000
# Physical device (Expo Go): use the host machine's LAN IP, e.g.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
